# Copia este archivo como .env y llena lo que tengas.

# Claude (sin esto la agencia corre en MODO DEMO con guiones de ejemplo)
ANTHROPIC_API_KEY=
# Opcional: modelo y nivel de esfuerzo (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Telegram: crea un bot con @BotFather y pega el token.
# Luego escríbele /start a tu bot: te responde con tu CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dirección pública donde corre la agencia (para los enlaces en Telegram)
PUBLIC_URL=http://localhost:3000

# Clave para que nadie más entre a tu oficina (recomendado si la publicas en internet)
ACCESS_KEY=

PORT=3000
